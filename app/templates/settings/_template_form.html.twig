{% extends app.request.xmlHttpRequest ? '_modal.html.twig' : '_modal_page.html.twig' %}

{% block modal_title %}{{ template.id ? template.name : 'Nuova lavorazione tipo' }}{% endblock %}

{% block modal_content %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-sm-8">{{ form_row(form.name) }}</div>
            <div class="col-sm-4">{{ form_row(form.estimatedMinutes) }}</div>
            <div class="col-12">{{ form_row(form.checklistText) }}</div>
            <div class="col-sm-4">{{ form_row(form.sort) }}</div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary"><i class="fa fa-check"></i> Salva</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
