{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ 'Bacheca lavori'|trans }}{% endblock %}

{% block body %}
    {% set actions %}
        <a class="btn btn-light" href="{{ path('order_index') }}"><i class="fa fa-list"></i> {{ 'Vista elenco'|trans }}</a>
        <a class="btn btn-primary" href="{{ path('order_new') }}"><i class="fa fa-plus"></i> {{ 'Nuova accettazione'|trans }}</a>
    {% endset %}
    {{ include('_page_header.html.twig', {icon: 'fa-table-columns', title: 'Bacheca lavori'|trans, subtitle: '%count% veicolo in officina|%count% veicoli in officina'|trans({'%count%': count})|e ~ '<span class="hide-mobile"> · ' ~ 'trascina una scheda per cambiarne lo stato'|trans|e ~ '</span>', actions: actions}) }}

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <div class="filter-chips" id="boardFilter" role="group" aria-label="{{ 'Filtra per meccanico'|trans }}">
            <button class="active" data-value="">{{ 'Tutti'|trans }}</button>
            {% for m in mechanics %}<button data-value="m{{ m.id }}">{{ m.name }}</button>{% endfor %}
            <button data-value="none">{{ 'Da assegnare'|trans }}</button>
        </div>
        <div class="search-pill"><i class="fa fa-search"></i><input type="search" id="boardSearch" placeholder="{{ 'Cerca targa, cliente, ordine...'|trans }}" aria-label="{{ 'Cerca nella bacheca'|trans }}"></div>
    </div>

    <nav class="board-jump only-mobile-block" aria-label="{{ 'Vai alla colonna'|trans }}">
        {% set short = {ACCEPTED: 'Da iniziare', IN_PROGRESS: 'In lavoro', WAITING: 'In attesa', READY: 'Pronte', DELIVERED: 'Consegnate'} %}
        {% for status, col in columns %}<a href="#col-{{ status }}"><i class="kdot" style="background: {{ col.color }}"></i>{{ short[status]|trans }} <b>{{ col.orders|length }}</b></a>{% endfor %}
    </nav>

    <div class="board-wrap">
        <div class="board" id="board" data-token="{{ csrf_token('submit') }}">
            {% for status, col in columns %}
                <section class="kcol" id="col-{{ status }}" data-status="{{ status }}" aria-label="{{ col.label }}">
                    <div class="kcol-head"><span><i class="kdot" style="background: {{ col.color }}"></i>{{ col.label }}</span><span class="kcount">{{ col.orders|length }}</span></div>
                    {% for o in col.orders %}
                        {% set tags = o.activeTasks|map(t => t.mechanic ? 'm' ~ t.mechanic.id : 'none')|join(' ') %}
                        <a class="kcard k-{{ o.status }}{{ o.late ? ' is-late' }}" href="{{ path('order_show', {id: o.id}) }}" draggable="true"
                           data-order="{{ o.id }}" data-status-url="{{ path('order_status', {id: o.id}) }}" data-filter="{{ tags }}"
                           data-search="{{ (o.code ~ ' ' ~ o.vehicle.plate ~ ' ' ~ o.vehicle.name ~ ' ' ~ o.customer.name)|lower }}">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <span class="kcode">{{ o.code }}</span>{{ ui.plate(o.vehicle) }}
                            </div>
                            <div class="kcar">{{ o.vehicle.name }}</div>
                            <div class="mini text-muted">{{ o.customer.name }}</div>
                            {% if o.status == 'IN_PROGRESS' and o.runningTask %}
                                <span class="flag f-red">{{ o.runningTask.mechanic.name ?? '' }} · {{ '%worked% su %estimated%'|trans({'%worked%': o.runningTask.workedSeconds|duration, '%estimated%': o.runningTask.estimatedMinutes|minutes}) }}</span>
                            {% elseif o.status == 'WAITING' and o.waitingReason %}
                                <span class="flag f-amber">{{ o.waitingReason }}</span>
                            {% elseif o.status == 'READY' %}
                                <span class="flag f-green">{{ o.customerNotifiedAt ? 'Cliente avvisato %when%'|trans({'%when%': o.customerNotifiedAt|when}) : 'Da avvisare il cliente'|trans }}</span>
                            {% elseif o.hasUnassignedTasks and o.status != 'DELIVERED' %}
                                <span class="flag f-red">{{ 'Senza meccanico'|trans }}</span>
                            {% endif %}
                            {% if o.proposedTasks|length %}<span class="flag f-amber">{{ '%count% da autorizzare'|trans({'%count%': o.proposedTasks|length}) }}</span>{% endif %}
                            <ul class="ktasks">
                                {% for t in o.tasks|filter(t => t.status != 'REJECTED') %}
                                    <li><span class="tdot t-{{ t.status }}" title="{{ t.statusLabel }}"></span><span>{{ t.title }}</span>{{ ui.mav(t.mechanic) }}</li>
                                {% else %}
                                    <li class="text-muted">{{ 'Nessuna lavorazione'|trans }}</li>
                                {% endfor %}
                            </ul>
                            <div class="progress-thin dark"><div style="width: {{ o.progressPct }}%"></div></div>
                            <div class="kfoot">
                                <span class="{{ o.late ? 'text-danger' }}">{{ o.status == 'DELIVERED' ? 'Consegnata %when%'|trans({'%when%': o.deliveredAt|when(false)}) : (o.promisedAt ? 'Consegna %when%'|trans({'%when%': o.promisedAt|when}) : 'Consegna da concordare'|trans) }}</span>
                                <span class="text-muted">{{ o.doneCount }}/{{ o.activeTasks|length }}</span>
                            </div>
                        </a>
                    {% endfor %}
                    <div class="kempty"{% if col.orders|length %} hidden{% endif %}>{{ 'Nessun veicolo'|trans }}</div>
                </section>
            {% endfor %}
        </div>
    </div>

    {# motivo dell'attesa quando si trascina in "In attesa" #}
    <div class="modal fade" id="waitModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" data-native>
                <div class="modal-header"><h5 class="modal-title">{{ 'Perché è ferma?'|trans }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Chiudi'|trans }}"></button></div>
                <div class="modal-body">
                    <div class="choice-pills mb-3">
                        {% for r in ['Attesa ricambi', 'Attesa OK del cliente', 'Il cliente deve portare/ritirare', 'Lavorazione esterna'] %}
                            <div class="form-check"><input class="form-check-input" type="radio" name="reasonChoice" id="wr{{ loop.index }}" value="{{ r }}"{{ loop.first ? ' checked' }}><label class="form-check-label" for="wr{{ loop.index }}">{{ r|trans }}</label></div>
                        {% endfor %}
                    </div>
                    <label class="form-label" for="waitNote">{{ 'Dettagli (facoltativo)'|trans }}</label>
                    <input class="form-control" id="waitNote" placeholder="{{ 'es. volano in arrivo lunedì'|trans }}">
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'Annulla'|trans }}</button><button class="btn btn-primary">{{ 'Sposta in attesa'|trans }}</button></div>
            </form>
        </div>
    </div>
{% endblock %}
