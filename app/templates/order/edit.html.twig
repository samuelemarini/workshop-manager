{% extends 'base.html.twig' %}

{% block title %}{{ 'Modifica %code%'|trans({'%code%': order.code}) }}{% endblock %}

{% block body %}
    {{ include('_page_header.html.twig', {back: path('order_show', {id: order.id}), title: 'Modifica %code%'|trans({'%code%': order.code}), subtitle: order.vehicle ~ ' · ' ~ order.customer.name}) }}

    <div class="card-box" style="max-width: 1100px">
        {{ form_start(form) }}
            <div class="row">
                <div class="col-lg-6">{{ form_row(form.vehicle) }}</div>
                <div class="col-lg-6">{{ form_row(form.customer) }}</div>
                <div class="col-sm-6 col-lg-3">{{ form_row(form.promisedAt) }}</div>
                <div class="col-sm-6 col-lg-3">{{ form_row(form.kmIn) }}</div>
                <div class="col-sm-6 col-lg-3">{{ form_row(form.fuelLevel) }}</div>
                <div class="col-sm-6 col-lg-3">{{ form_row(form.quoteAmount) }}</div>
                <div class="col-12">{{ form_row(form.courtesyCar) }}</div>
                <div class="col-lg-6">{{ form_row(form.customerRequest) }}</div>
                <div class="col-lg-6">{{ form_row(form.intakeNotes) }}</div>
                <div class="col-12">{{ form_row(form.internalNotes) }}</div>
            </div>
            <div class="form-actions">
                <a class="btn btn-light" href="{{ path('order_show', {id: order.id}) }}">{{ 'Annulla'|trans }}</a>
                <button class="btn btn-primary"><i class="fa fa-check"></i> {{ 'Salva'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
