{% extends 'base.html.twig' %}

{% block title %}{{ 'Utenti'|trans }}{% endblock %}

{% block body %}
    {% set actions %}
        <a class="btn btn-primary" href="{{ path('user_new') }}"><i class="fa fa-plus"></i> {{ 'Nuovo utente'|trans }}</a>
    {% endset %}
    {{ include('_page_header.html.twig', {icon: 'fa-users', title: 'Utenti'|trans, subtitle: '%count% utente attivo|%count% utenti attivi'|trans({'%count%': users|length}), actions: actions}) }}

    <div class="table-card">
        <div class="table-toolbar">
            <div class="search-pill"><i class="fa fa-search"></i><input type="text" placeholder="{{ 'Cerca...'|trans }}" data-table-search="#users" aria-label="{{ 'Cerca utente'|trans }}"></div>
        </div>
        <table class="app-table cards-mobile" id="users" data-datatable data-order='[[1,"asc"]]'>
            <thead><tr><th>{{ 'Username'|trans }}</th><th>{{ 'Nome'|trans }}</th><th>{{ 'E-mail'|trans }}</th><th>{{ 'Ruoli'|trans }}</th></tr></thead>
            <tbody>
                {% for user in users %}
                    <tr data-href="{{ path('user_edit', {id: user.id}) }}">
                        <td class="code cell-head">{{ user.username }}</td>
                        <td>{{ user.fullName }}</td>
                        <td>{{ user.email }}</td>
                        <td>{% for r in user.customroles %}<span class="status s-dark me-1">{{ r.name }}</span>{% endfor %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
