{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ customer.id ? customer.name : 'Nuovo cliente' }}{% endblock %}

{% block body %}
    {% set actions %}
        {% if customer.id %}{{ ui.post_button(path('customer_delete', {id: customer.id}), ' Elimina', 'fa-trash', 'btn-light text-danger', 'Eliminare il cliente ' ~ customer.name ~ '?') }}{% endif %}
    {% endset %}
    {{ include('_page_header.html.twig', {back: path('customer_index'), title: customer.id ? customer.name : 'Nuovo cliente', actions: actions}) }}

    <div class="card-box" style="max-width: 960px">
        {{ form_start(form) }}
            <div class="row">
                <div class="col-md-8">{{ form_row(form.name) }}</div>
                <div class="col-md-4">{{ form_row(form.vatNumber) }}</div>
                <div class="col-md-4">{{ form_row(form.phone) }}</div>
                <div class="col-md-4">{{ form_row(form.email) }}</div>
                <div class="col-md-4">{{ form_row(form.contactPreference) }}</div>
                <div class="col-md-6">{{ form_row(form.address) }}</div>
                <div class="col-md-2">{{ form_row(form.zip) }}</div>
                <div class="col-md-4">{{ form_row(form.city) }}</div>
                <div class="col-md-4">{{ form_row(form.contactPerson) }}</div>
                <div class="col-md-4">{{ form_row(form.country) }}</div>
                <div class="col-12">{{ form_row(form.notes) }}</div>
            </div>
            <div class="form-actions">
                <a class="btn btn-light" href="{{ path('customer_index') }}">Annulla</a>
                <button class="btn btn-primary"><i class="fa fa-check"></i> Salva</button>
            </div>
        {{ form_end(form) }}
    </div>

    {% if customer.id %}
        <div class="card-box" style="max-width: 960px">
            <div class="card-title"><span><i class="fa fa-car-side"></i> Veicoli</span><a class="mini" href="{{ path('vehicle_new', {owner: customer.id}) }}"><i class="fa fa-plus"></i> Aggiungi</a></div>
            {% for v in vehicles %}
                <a class="list-row text-body" href="{{ path('vehicle_show', {id: v.id}) }}">{{ ui.plate(v) }}<div class="grow fw-semibold">{{ v.name }} <span class="text-muted fw-normal">{{ v.version }}</span></div><span class="mini text-muted">{{ v.workOrders|length }} ordini</span></a>
            {% else %}
                <div class="empty-state py-2">Nessun veicolo registrato</div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
