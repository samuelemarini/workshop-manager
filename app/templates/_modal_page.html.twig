{# Stesso contenuto della modale, aperto come pagina (link diretto o JavaScript disattivato) #}
{% extends 'base.html.twig' %}

{% block title %}{{ block('modal_title') }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="page-title">
            <a class="back-btn" href="javascript:history.back()"><i class="fa fa-arrow-left"></i></a>
            <h1>{{ block('modal_title') }}</h1>
        </div>
    </div>
    <div class="card-box" style="max-width: 860px">
        {{ block('modal_content') }}
    </div>
{% endblock %}
