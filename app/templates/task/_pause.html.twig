{% extends app.request.xmlHttpRequest ? '_modal.html.twig' : '_modal_page.html.twig' %}

{% block modal_title %}{{ 'Pausa'|trans }} · {{ task.title }}{% endblock %}

{% block modal_content %}
    {{ include('task/_task_head.html.twig') }}
    <form method="post" action="{{ path('task_pause', {id: task.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
        <label class="form-label">{{ task.openEntry ? 'Perché si ferma %name%?'|trans({'%name%': task.openEntry.mechanic.name}) : 'Perché si ferma?'|trans }}</label>
        <div class="choice-pills mb-2">
            {% for reason, icon in reasons %}
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="reason" id="pr{{ loop.index }}" value="{{ reason }}"{{ loop.first ? ' checked' }}>
                    <label class="form-check-label" for="pr{{ loop.index }}"><i class="fa {{ icon }}"></i> {{ reason|trans }}</label>
                </div>
            {% endfor %}
        </div>
        <div class="form-text mb-3">{{ 'Attesa ricambi e attesa OK del cliente mettono l\'auto "In attesa" se nessuno ci sta lavorando.'|trans }}</div>
        <div class="form-actions">
            <button class="btn btn-primary"><i class="fa fa-pause"></i> {{ 'Metti in pausa'|trans }}</button>
        </div>
    </form>
{% endblock %}
