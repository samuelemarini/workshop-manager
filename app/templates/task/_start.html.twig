{% extends app.request.xmlHttpRequest ? '_modal.html.twig' : '_modal_page.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block modal_title %}{{ task.status == 'PAUSED' ? 'Riprendi'|trans : 'Avvia'|trans }} · {{ task.title }}{% endblock %}

{% block modal_content %}
    {{ include('task/_task_head.html.twig') }}
    {% set current = task.openEntry ? task.openEntry.mechanic : task.mechanic %}
    <form method="post" action="{{ path('task_start', {id: task.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
        <label class="form-label">{{ 'Chi ci lavora?'|trans }}</label>
        <div class="choice-pills mb-2">
            {% for m in mechanics %}
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mechanic" id="sm{{ m.id }}" value="{{ m.id }}" required{{ current == m ? ' checked' }}>
                    <label class="form-check-label" for="sm{{ m.id }}">{{ ui.mav(m) }} {{ m.name }}</label>
                </div>
            {% endfor %}
        </div>
        {% set others = mechanics|filter(m => busy[m.id] is defined and busy[m.id] != task) %}
        {% if others|length %}
            <div class="form-text mb-3">
                {% for m in others %}
                    <div><i class="fa fa-circle-info"></i> {{ '%name% sta lavorando su %order% · %task%: se lo scegli quella va in pausa.'|trans({'%name%': m.name, '%order%': busy[m.id].workOrder.code, '%task%': busy[m.id].title}) }}</div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="form-actions">
            <button class="btn btn-primary"><i class="fa fa-play"></i> {{ task.status == 'PAUSED' ? 'Riprendi'|trans : 'Avvia'|trans }}</button>
        </div>
    </form>
{% endblock %}
