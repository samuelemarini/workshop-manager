{% extends app.request.xmlHttpRequest ? '_modal.html.twig' : '_modal_page.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block modal_title %}{{ task.status == 'PAUSED' ? 'Riprendi' : 'Avvia' }} · {{ task.title }}{% endblock %}

{% block modal_content %}
    {{ include('task/_task_head.html.twig') }}
    {% set current = task.openEntry ? task.openEntry.mechanic : task.mechanic %}
    <form method="post" action="{{ path('task_start', {id: task.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
        <label class="form-label">Chi ci lavora?</label>
        <div class="choice-pills mb-2">
            {% for m in mechanics %}
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mechanic" id="sm{{ m.id }}" value="{{ m.id }}" required{{ current == m ? ' checked' }}>
                    <label class="form-check-label" for="sm{{ m.id }}">{{ ui.mav(m) }} {{ m.name }}</label>
                </div>
            {% endfor %}
        </div>
        {% set others = mechanics|filter(m => busy[m.id] is defined and busy[m.id] != task) %}
        {% if others|length %}
            <div class="form-text mb-3">
                {% for m in others %}
                    <div><i class="fa fa-circle-info"></i> {{ m.name }} sta lavorando su {{ busy[m.id].workOrder.code }} · {{ busy[m.id].title }}: se lo scegli quella va in pausa.</div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="form-actions">
            <button class="btn btn-primary"><i class="fa fa-play"></i> {{ task.status == 'PAUSED' ? 'Riprendi' : 'Avvia' }}</button>
        </div>
    </form>
{% endblock %}
