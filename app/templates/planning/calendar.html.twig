{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ 'Calendario lavori'|trans }}{% endblock %}

{% block body %}
    {% if mode == 'week' %}
        {% set title = from|date('Yn') == to|date('Yn')
            ? 'Settimana dal %from% al %to% %month% %year%'|trans({'%from%': from|date('j'), '%to%': to|date('j'), '%month%': to|local_date('MMMM'), '%year%': to|date('Y')})
            : 'Settimana dal %from% al %to%'|trans({'%from%': from|date_skeleton('dMMMM'), '%to%': to|date_skeleton('dMMMMy')}) %}
    {% else %}
        {% set title = day|local_date('LLLL y')|capitalize %}
    {% endif %}
    {% set actions %}
        <a class="btn btn-light btn-icon-lg" href="{{ path('planning_calendar', {mode: mode, day: prev|date('Y-m-d')}) }}" aria-label="{{ (mode == 'week' ? 'Settimana precedente' : 'Mese precedente')|trans }}"><i class="fa fa-chevron-left"></i></a>
        <a class="btn btn-light" href="{{ path('planning_calendar', {mode: mode}) }}">{{ (mode == 'week' ? 'Questa settimana' : 'Questo mese')|trans }}</a>
        <a class="btn btn-light btn-icon-lg" href="{{ path('planning_calendar', {mode: mode, day: next|date('Y-m-d')}) }}" aria-label="{{ (mode == 'week' ? 'Settimana successiva' : 'Mese successivo')|trans }}"><i class="fa fa-chevron-right"></i></a>
        <a class="btn btn-primary" href="{{ path('order_new') }}"><i class="fa fa-plus"></i> {{ 'Nuova accettazione'|trans }}</a>
    {% endset %}
    {{ include('_page_header.html.twig', {icon: mode == 'week' ? 'fa-calendar-week' : 'fa-calendar', title: 'Calendario lavori'|trans, subtitle: title|e ~ (mode == 'week' ? '<span class="hide-mobile"> · ' ~ 'trascina un lavoro su un altro giorno o meccanico'|trans|e ~ '</span>' : ' · ' ~ 'tocca un giorno per aprirne il planning'|trans|e), actions: actions}) }}

    <section class="table-card">
        <div class="table-toolbar">
            {{ include('planning/_modes.html.twig', {current: mode}) }}
            <div class="plan-legend hide-mobile">
                <span><i class="sw b-run"></i>{{ 'In corso'|trans }}</span>
                <span><i class="sw" style="border: 2px solid #1a1718"></i>{{ 'Pianificata'|trans }}</span>
                <span><i class="sw b-done"></i>{{ 'Completata'|trans }}</span>
                <span><i class="sw b-block"></i>{{ 'In attesa'|trans }}</span>
                <span><i class="sw b-tbc"></i>{{ 'Da autorizzare'|trans }}</span>
                <span><i class="fa fa-key text-muted"></i>{{ 'Consegna'|trans }}</span>
            </div>
        </div>

        {% if mode == 'week' %}
            {% set rows = mechanics|map(m => {key: m.id, mechanic: m, capacity: m.dailyHours * 60}) %}
            {% if unassigned %}{% set rows = rows|merge([{key: 0, mechanic: null, capacity: 0}]) %}{% endif %}
            <div class="agenda only-mobile-block">
                {% for key, d in days %}
                    <div class="agenda-group{{ d.date == today ? ' is-today' }}">
                        <a class="agenda-head agenda-day" href="{{ path('planning', {day: key}) }}">
                            <span class="agenda-date"><small>{{ d.date|dow }}</small>{{ d.date|date('j') }}</span>
                            <div class="flex-grow-1">
                                <div class="fw-bold">{{ d.date|local_date('EEEE')|capitalize }}</div>
                                <div class="mini text-muted">{% for m in mechanics %}{% if d.load[m.id] is defined %}{{ m.name }} {{ (d.load[m.id] / 60)|num(1) }} h · {% endif %}{% endfor %}{{ '%count% lavoro|%count% lavori'|trans({'%count%': d.items|length}) }}</div>
                            </div>
                            <i class="fa fa-chevron-right text-muted"></i>
                        </a>
                        {% for o in d.deliveries %}
                            <a class="wk-delivery{{ o.status in ['READY', 'DELIVERED'] ? ' is-ready' }}{{ o.late ? ' is-late' }} mb-1" href="{{ path('order_show', {id: o.id}) }}"><i class="fa fa-key"></i> <b>{{ o.promisedAt|date('G:i') }}</b> {{ o.vehicle.name }} <span>{{ o.vehicle.plateLabel }}</span></a>
                        {% endfor %}
                        {% for i in d.items %}
                            {% set o = i.task.workOrder %}
                            <a class="agenda-item b-{{ i.kind }}" href="#" data-modal="{{ path('task_plan', {id: i.task.id}) }}" data-title="{{ o.code }} · {{ i.task.title }}">
                                <span class="agenda-time">{{ i.time ?? '—' }}</span>
                                <span class="agenda-body"><strong>{{ o.code }} · {{ i.task.title }}</strong><span>{{ o.vehicle.name }} · {{ (i.minutes / 60)|num(1) }} h</span></span>
                                {{ ui.mav(i.task.mechanic) }}
                            </a>
                        {% endfor %}
                        {% if not d.items|length and not d.deliveries|length %}<div class="mini text-muted pb-1">{{ 'Niente in programma'|trans }}</div>{% endif %}
                    </div>
                {% endfor %}
            </div>

            <div class="pg-wrap hide-mobile">
                <div class="wk" id="weekGrid" style="--days: {{ days|length }}" data-move-url="{{ path('planning_move') }}" data-token="{{ csrf_token('submit') }}">
                    <div class="wk-row wk-head">
                        <div class="wk-label">{{ 'Meccanico'|trans }}</div>
                        {% for key, d in days %}
                            <a class="wk-day{{ d.date == today ? ' today' }}" href="{{ path('planning', {day: key}) }}">{{ d.date|dow }} <b>{{ d.date|date('j') }}</b></a>
                        {% endfor %}
                    </div>
                    <div class="wk-row wk-deliveries">
                        <div class="wk-label"><span class="soft-icon i-grey"><i class="fa fa-key"></i></span><span class="fw-bold">{{ 'Consegne'|trans }}</span></div>
                        {% for key, d in days %}
                            <div class="wk-cell{{ d.date == today ? ' today' }}">
                                {% for o in d.deliveries %}
                                    <a class="wk-delivery{{ o.status in ['READY', 'DELIVERED'] ? ' is-ready' }}{{ o.late ? ' is-late' }}" href="{{ path('order_show', {id: o.id}) }}" title="{{ o.code }} · {{ o.customer.name }} · {{ o.statusLabel }}">
                                        <b>{{ o.promisedAt|date('G:i') }}</b> {{ o.vehicle.name }} <span>{{ o.vehicle.plateLabel }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                    {% for r in rows %}
                        <div class="wk-row">
                            <div class="wk-label">
                                {{ ui.mav(r.mechanic, 'lg') }}
                                <div><div class="fw-bold">{{ r.mechanic ? r.mechanic.name : 'Da assegnare'|trans }}</div>{% if r.mechanic %}<div class="mini text-muted">{{ '%hours% h/giorno'|trans({'%hours%': r.mechanic.dailyHours|num}) }}</div>{% endif %}</div>
                            </div>
                            {% for key, d in days %}
                                {% set load = d.load[r.key] ?? 0 %}
                                <div class="wk-cell{{ d.date == today ? ' today' }}{{ d.date|date('N') >= 6 ? ' weekend' }}" data-drop-day="{{ key }}" data-mechanic="{{ r.mechanic ? r.mechanic.id : '' }}">
                                    {% if r.capacity %}
                                        {% set pct = (load / r.capacity * 100)|round %}
                                        <div class="wk-load{{ pct > 100 ? ' is-over' : (pct >= 85 ? ' is-full') }}" title="{{ '%done% h su %total%'|trans({'%done%': (load / 60)|num(1), '%total%': (r.capacity / 60)|num}) }}"><span style="width: {{ min(100, pct) }}%"></span></div>
                                        <div class="wk-hours">{{ load ? (load / 60)|num(1) ~ ' h' : '' }}</div>
                                    {% endif %}
                                    {% for i in d.items|filter(i => i.mechanicKey == r.key) %}
                                        {% set o = i.task.workOrder %}
                                        <a class="wk-item b-{{ i.kind }}" href="#" data-modal="{{ path('task_plan', {id: i.task.id}) }}" data-title="{{ o.code }} · {{ i.task.title }}"
                                           title="{{ i.task.title }} · {{ o.vehicle.name }} {{ o.vehicle.plateLabel }} · {{ i.task.statusLabel }} · {{ (i.minutes / 60)|num(1) }} h"
                                           {% if i.task.status in ['TODO', 'PAUSED'] %}draggable="true" data-task="{{ i.task.id }}" data-time="{{ i.time ?? '8:00' }}"{% endif %}>
                                            <strong>{{ i.time ? i.time ~ ' · ' }}{{ o.code }}</strong>
                                            <span>{{ i.task.title }}</span>
                                            <small>{{ o.vehicle.name }} · {{ (i.minutes / 60)|num(1) }} h</small>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="pg-wrap">
                <div class="mo">
                    {% for n in weekday_names() %}<div class="mo-dow">{{ n }}</div>{% endfor %}
                    {% for key, d in days %}
                        {% set other = d.date|date('n') != day|date('n') %}
                        {% set free = d.items|filter(i => i.mechanicKey == 0 and i.task.counts) %}
                        <a class="mo-day{{ other ? ' other' }}{{ d.date == today ? ' today' }}{{ d.date|date('N') >= 6 ? ' weekend' }}" href="{{ path('planning', {day: key}) }}">
                            <div class="mo-num">{{ d.date|date('j') }}</div>
                            {% for m in mechanics %}
                                {% set load = d.load[m.id] ?? 0 %}
                                {% if load %}
                                    {% set pct = (load / (m.dailyHours * 60) * 100)|round %}
                                    <div class="mo-mech{{ pct > 100 ? ' is-over' : (pct >= 85 ? ' is-full') }}">{{ ui.mav(m) }}<span>{{ (load / 60)|num(1) }} h</span><span class="mo-count">{{ '%count% lav.'|trans({'%count%': d.items|filter(i => i.mechanicKey == m.id)|length}) }}</span></div>
                                {% endif %}
                            {% endfor %}
                            {% if free|length %}<div class="mo-mech is-free">{{ ui.mav(null) }}<span>{{ '%count% da assegnare'|trans({'%count%': free|length}) }}</span></div>{% endif %}
                            {% if d.deliveries|length %}
                                <div class="mo-deliv" title="{{ d.deliveries|map(o => o.vehicle.name ~ ' ' ~ o.vehicle.plateLabel)|join(', ') }}"><i class="fa fa-key"></i> {{ d.deliveries|length }} · {{ d.deliveries|slice(0, 2)|map(o => o.vehicle.model)|join(', ') }}{{ d.deliveries|length > 2 ? '…' }}</div>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
