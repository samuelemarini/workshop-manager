{% extends app.request.xmlHttpRequest ? '_modal.html.twig' : '_modal_page.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block modal_title %}Pianifica · {{ task.title }}{% endblock %}

{% block modal_content %}
    {% set o = task.workOrder %}
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <a class="code-lg" href="{{ path('order_show', {id: o.id}) }}">{{ o.code }}</a>{{ ui.plate(o.vehicle) }}<span class="text-muted">{{ o.vehicle.name }} · {{ o.customer.name }}</span>
        {% if o.promisedAt %}<span class="ms-auto mini fw-bold">Consegna {{ o.promisedAt|when }}</span>{% endif %}
    </div>
    {{ form_start(form) }}
        <div class="row">
            <div class="col-12">{{ form_row(form.mechanic) }}</div>
            <div class="col-sm-7">{{ form_row(form.plannedStart) }}</div>
            <div class="col-sm-5">{{ form_row(form.estimatedMinutes) }}</div>
        </div>
        {% if others %}
            <div class="mb-3">
                <label class="form-label">Pianifica anche, una dopo l'altra</label>
                <div class="template-checks">
                    {% for t in others %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="chain[]" value="{{ t.id }}" id="chain_{{ t.id }}"{{ chainDefault ? ' checked' }}>
                            <label class="form-check-label" for="chain_{{ t.id }}">{{ t.title }} · {{ t.estimatedMinutes|minutes }}</label>
                        </div>
                    {% endfor %}
                </div>
                <div class="form-text">Stesso meccanico: ognuna parte quando finisce la precedente, saltando pausa pranzo e chiusura.</div>
            </div>
        {% endif %}
        <div class="form-actions">
            <a class="btn btn-light me-auto" href="{{ path('order_show', {id: o.id}) }}">Apri l'ordine</a>
            <button class="btn btn-primary"><i class="fa fa-check"></i> Salva</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
