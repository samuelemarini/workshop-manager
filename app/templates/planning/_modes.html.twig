{# Giorno / Settimana / Mese: stessa data di riferimento #}
<div class="seg" role="group" aria-label="{{ 'Vista'|trans }}">
    <a class="{{ current == 'day' ? 'active' }}" href="{{ path('planning', {day: day|date('Y-m-d')}) }}">{{ 'Giorno'|trans }}</a>
    <a class="{{ current == 'week' ? 'active' }}" href="{{ path('planning_calendar', {mode: 'week', day: day|date('Y-m-d')}) }}">{{ 'Settimana'|trans }}</a>
    <a class="{{ current == 'month' ? 'active' }}" href="{{ path('planning_calendar', {mode: 'month', day: day|date('Y-m-d')}) }}">{{ 'Mese'|trans }}</a>
</div>
