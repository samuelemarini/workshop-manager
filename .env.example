# Sviluppo: copia in .env (non versionato). Produzione: imposta le stesse variabili nello stack
# (Portainer: "Environment variables") e usa docker-compose.prod.yml.

# Password del database. Solo lettere e numeri: finisce dentro DATABASE_URL.
DB_PASSWORD=cambiami

# --- solo produzione (in sviluppo stanno in app/.env.local) ---
# openssl rand -hex 16
APP_SECRET=
# Crea l'utente "admin" al primo avvio; poi cambiala dal profilo
ADMIN_PASSWORD=
# Token del tunnel Cloudflare (Zero Trust > Networks > Tunnels): pubblica il sito in HTTPS
TUNNEL_TOKEN=
# Indirizzo pubblico del sito (per i link generati fuori da una richiesta)
DEFAULT_URI=https://officina.example.com
# Porte pubblicate sull'host (in sviluppo i default sono 20036 e 30036)
WEB_PORT=8081
DB_PORT=3309
# 127.0.0.1 = database raggiungibile solo dal server, 0.0.0.0 = da tutta la rete
DB_BIND=127.0.0.1
